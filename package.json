{
  "name": "plus-plus-sandbox",
  "version": "0.0.1",
  "private": true,
  "description": "Plus+ Sandbox",
  "main": "src/server.js",
  "scripts": {
    "start:server": "node src/server.js",
    "start:client": "http-server . -c-1",
    "build": "node scripts/package.js",
    "postinstall": "node scripts/package.js"
  },
  "keywords": [
    "iptv"
  ],
  "author": "eoussama",
  "license": "MIT",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=24.21.0",
    "pnpm": "12.14.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.14.0",
      "onFail": "error"
    },
    "runtime": {
      "name": "node",
      "version": ">=24.21.0",
      "onFail": "error"
    }
  },
  "dependencies": {
    "@videojs/hlsjs-video": "^10.2.0",
    "@videojs/html": "^10.2.0",
    "express": "^5.3.0",
    "skeleton-css": "^2.0.4"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "http-server": "^14.1.1"
  }
}
